  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b43d8063f0bd8c14195f808464096860, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AssignPoem
  _revealThreshold: 0.05
  _hideThreshold: 0.6
  _poemId: 2
  _assignedDate: 30 settembre 1916
  _assignedPoemName: In memoria
  _assignedPlace: Locvizza
  _assignedPoemText: 
  _poemVoice: {fileID: 8300000, guid: 77c9d58dd634ae54e9229db24262b160, type: 3}
  poemInfo: {fileID: 11400000, guid: b79b9d6bac85cbf4194496d185b690f6, type: 2}
  _fragment: 3
  _fragmentCount: 3
  _fragmentText: "L\u2019ho accompagnato\ninsieme alla padrona dell\u2019albergo\ndove
    abitavamo\na Parigi\ndal numero 5 della rue des Carmes\nappassito vicolo in discesa.\nRiposa\nnel
    camposanto d\u2019Ivry\nsobborgo che pare\nsempre\nin una giornata\ndi una\ndecomposta
    fiera\nE forse io solo\nso ancora\nche visse"
  _floorColor: {r: 0.81960785, g: 0, b: 0.05, a: 0.85}
  _floorPadding: 0.12
  _shimmer: 0.687
  _fadeSeconds: 2.5
