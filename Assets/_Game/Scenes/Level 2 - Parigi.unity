--- !u!114 &639435067
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 639435062}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0337850e7688759459a31cce09b42c75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examinable
  prompt: READ
  displayName: Moammed's Letters
  caption: "Moammed's letters. He wrote them at night, at this desk. He never sent
    them.\n\n<i>Paris, rue des Carmes, a winter night.</i>\n\nDear mother,\n\nHere
    they call me Marcel. I wear their coats, I speak their language, I drink coffee
    in their caf\xE9s and laugh when they laugh. But when I close my eyes I still
    hear the sea at Alexandria, and the voice of the muezzin over the roofs.\n\nI
    do not know how to tell you who I am now. I am no longer the son you remember,
    and I have not become anyone else.\n\nGiuseppe writes all night by the candle.
    He says that words can hold a man together. I try, but mine fall apart before
    the end of the page.\n\nI will write again tomorrow. Perhaps tomorrow I will
    send it.\n\n\u2014 M."
  model: {fileID: 0}
  scaleMultiplier: 1
  rotationOffset: {x: 0, y: 0, z: 0}
  voice: {fileID: 0}
  voiceVolume: 0.55
