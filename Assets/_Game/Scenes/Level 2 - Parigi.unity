--- !u!114 &918132427
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 918132426}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18838921448f49b4a98c9e597f9a2ccf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelFlow
  titleCard: "PARIGI \u2014 5 RUE DES CARMES \u2014 1912\u20131914"
  nextScene: Level 3 - Carso
  fallbackScene: MainMenu
  character: {fileID: 112685619}
  characterName: Apollinaire
  lookTarget: {fileID: 0}
  entryAnchor: {fileID: 1464042558}
  exitAnchor: {fileID: 1538469149}
  followerLeafFromStart: 1
  broom: {fileID: 172242566}
  observables:
  - {fileID: 647106019}
  - {fileID: 1577521724}
  - {fileID: 24526978}
  - {fileID: 112685618}
  characterExitPoint: {fileID: 0}
  characterOutside: {fileID: 0}
  door: {fileID: 0}
  doorHalfWidth: 0.42
  doorOpenAngle: -90
  doorSeconds: 0.8
  doorOpenClip: {fileID: 8300000, guid: 6230b49ceb891e646a213d36dbec7b86, type: 3}
  doorCloseClip: {fileID: 8300000, guid: 449b837bfdd575143b7a5c7faa036161, type: 3}
  doorVolume: 0.55
  walkSpeed: 1.1
  lookAtCharacterOnStart: 0
  exitCue: {fileID: 0}
  exitCueVolume: 0.7
  steps:
  - note: Arrival
    waitFor: 0
    amount: 0
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Rue des Carmes. I know this room. Two of us lived here.
        voice: {fileID: 8300000, guid: dc066c9fbceb9434b8e84427717cc36a, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Apollinaire
    waitFor: 128
    amount: 1
    objective: 
    lines:
    - speakerId: apollinaire
      pieces:
      - text: Giuseppe. I thought I'd find you here.
        voice: {fileID: 8300000, guid: e7e31d423209c6e4d8634e1788b9f490, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Only for a moment, Guillaume. I wanted to see the room again.
        voice: {fileID: 8300000, guid: 6c736c7b52cd1a34192e460bc0b956d2, type: 3}
        volume: 0.55
    - speakerId: apollinaire
      pieces:
      - text: The landlady hasn't touched anything. His things are still here.
        voice: {fileID: 8300000, guid: 178a4928b3674904ab83b7c03ea431b9, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Moammed at the window
    waitFor: 4096
    amount: 0
    objective: LOOK AT THE MAN BY THE WINDOW
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Moammed. He came from Alexandria with me. Here he called himself Marcel.
        voice: {fileID: 8300000, guid: b53ef6ac647e0fb4db5d46128fdd58ea, type: 3}
        volume: 0.55
    - speakerId: apollinaire
      pieces:
      - text: He never seemed to belong anywhere. Not in Egypt, not in Paris. Like
          most of us in this city.
        voice: {fileID: 8300000, guid: cf2f7af26c2991640aeacc51323ebab0, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 2
    fragment: 0
  - note: Broom
    waitFor: 2
    amount: 0
    objective: PICK UP THE BROOM
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Sweep between the beds
    waitFor: 4
    amount: 40
    objective: SWEEP BETWEEN THE TWO BEDS
    lines:
    - speakerId: apollinaire
      pieces:
      - text: You told me he always slept on the left. The light woke him on the
          other side.
        voice: {fileID: 8300000, guid: 373c9250f299fea48a320d31d544c53b, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Fragment 1
    waitFor: 1024
    amount: 0
    objective: SWEEP BETWEEN THE TWO BEDS
    lines:
    - speakerId: ungaretti
      pieces:
      - text: The words are in pieces. Like my memories of those days.
        voice: {fileID: 8300000, guid: 72ae1dac84fb159468c66550af2cd8a4, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 1
  - note: Transcribe 1
    waitFor: 2048
    amount: 0
    objective: KEEP YOUR EYES ON THE WORDS WHILE YOU TRANSCRIBE
    lines: []
    action: 1
    observableIndex: 0
    fragment: 1
  - note: The coat is gone
    waitFor: 512
    amount: 0
    objective: LOOK AT THE COAT ON THE CHAIR, THEN LOOK AWAY
    lines:
    - speakerId: ungaretti
      pieces:
      - text: His coat...
        voice: {fileID: 8300000, guid: 7363aae9e135f5e4e88d8151e7c361bb, type: 3}
        volume: 0.55
    - speakerId: apollinaire
      pieces:
      - text: The landlady gave it away. Someone needed it more than a memory did.
        voice: {fileID: 8300000, guid: 757a1482e4a673846ae5d268138292a6, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Fragment 2
    waitFor: 1024
    amount: 0
    objective: SWEEP IN FRONT OF THE DESK
    lines:
    - speakerId: apollinaire
      pieces:
      - text: He wrote letters at that desk, at night. Did he ever send one?
        voice: {fileID: 8300000, guid: badcb20aa1f384b48acbb19228f30198, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 2
  - note: Transcribe 2
    waitFor: 2048
    amount: 0
    objective: KEEP YOUR EYES ON THE WORDS WHILE YOU TRANSCRIBE
    lines: []
    action: 1
    observableIndex: 1
    fragment: 2
  - note: The shelf is empty
    waitFor: 512
    amount: 0
    objective: LOOK AT THE BOOKS ON THE SHELF, THEN LOOK AWAY
    lines:
    - speakerId: ungaretti
      pieces:
      - text: He read late into the night, by candlelight. Now the shelf is empty.
        voice: {fileID: 8300000, guid: 458b13053abf5ef43991a84d459c560c, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 1
    fragment: 0
  - note: Fragment 3
    waitFor: 1024
    amount: 0
    objective: SWEEP UNDER THE WINDOW
    lines:
    - speakerId: apollinaire
      pieces:
      - text: He liked the window. He said Paris looked better from above. Poets
          and exiles always choose the window.
        voice: {fileID: 8300000, guid: 0de8ff88a09c1864e91bd0eafa79dba2, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: At the cemetery there was only me and the landlady.
        voice: {fileID: 8300000, guid: 98a9489351391864ab4a20eb6ac16925, type: 3}
        volume: 0.55
    - speakerId: apollinaire
      pieces:
      - text: I know. I'm sorry I wasn't there.
        voice: {fileID: 8300000, guid: 52912c447215b8546bfb99786b6043c9, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: I'm the only one left who remembers him. If I don't write it down,
          no one ever will.
        voice: {fileID: 8300000, guid: e477c6ffc8124b34bbfb1d7201ef0cee, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 3
  - note: Transcribe 3
    waitFor: 2048
    amount: 0
    objective: KEEP YOUR EYES ON THE WORDS WHILE YOU TRANSCRIBE
    lines: []
    action: 1
    observableIndex: 2
    fragment: 3
  - note: Moammed is gone
    waitFor: 512
    amount: 0
    objective: LOOK AT MOAMMED, THEN LOOK AWAY
    lines:
    - speakerId: ungaretti
      pieces:
      - text: He left when I stopped looking.
        voice: {fileID: 8300000, guid: 915237a3c78034f4a8f1321797843977, type: 3}
        volume: 0.55
    action: 6
    observableIndex: 2
    fragment: 0
  - note: In memoria
    waitFor: 64
    amount: 0
    objective: 
    lines:
    - speakerId: apollinaire
      pieces:
      - text: You wrote it for him.
        voice: {fileID: 8300000, guid: c3ad508aa4a493e47b48713264b152d9, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: I wrote it three years later, in the trenches. The leaves were falling
          there too.
        voice: {fileID: 8300000, guid: f90b5341b5811394583448aee40bd9b6, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Look at Apollinaire
    waitFor: 4096
    amount: 0
    objective: LOOK AT {character}
    lines:
    - speakerId: apollinaire
      pieces:
      - text: Then go. And don't look back too much, my friend. Paris will wait for
          you.
        voice: {fileID: 8300000, guid: f411e8b3c258a3d42a4bc6b413be18f2, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 3
    fragment: 0
  - note: Apollinaire is gone
    waitFor: 512
    amount: 0
    objective: LOOK AWAY FROM {character}
    lines: []
    action: 4
    observableIndex: 3
    fragment: 0
  - note: Turn around
    waitFor: 256
    amount: 0
    objective: TURN AROUND
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  firstGustLines: []
  objectiveSize: 34
