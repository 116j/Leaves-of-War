  m_Script: {fileID: 11500000, guid: b43d8063f0bd8c14195f808464096860, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AssignPoem
  _revealThreshold: 0.05
  _hideThreshold: 0.6
  _poemId: 1
  _assignedDate: 1914-1915
  _assignedPoemName: Agonia
  _assignedPlace: Milano
  _assignedPoemText: "Morire come le allodole assetate\nsul miraggio\nO come la quaglia\npassato
    il mare\nnei primi cespugli\nperch\xE8 di volare\nnon ha pi\xF9 voglia\nMa non
    vivere di lamento\ncome un cardellino accecato"
  _poemVoice: {fileID: 8300000, guid: d0505963b9530fc408881e10bfe71d30, type: 3}
  poemInfo: {fileID: 11400000, guid: b79b9d6bac85cbf4194496d185b690f6, type: 2}
  _floorColor: {r: 0.26666668, g: 0.066332534, b: 0.047058824, a: 1}
  _floorPadding: 0.12
  _shimmer: 0.35
  _fadeSeconds: 2.5
