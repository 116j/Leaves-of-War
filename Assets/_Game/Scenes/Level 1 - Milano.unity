--- !u!114 &152539959
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 152539958}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18838921448f49b4a98c9e597f9a2ccf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelFlow
  titleCard: "MILANO \u2014 1914\u20131915"
  nextScene: Level 2 - Parigi
  fallbackScene: MainMenu
  character: {fileID: 123916072}
  characterName: Carlo
  lookTarget: {fileID: 0}
  entryAnchor: {fileID: 0}
  exitAnchor: {fileID: 770923964}
  followerLeafFromStart: 0
  broom: {fileID: 1821544169}
  observables:
  - {fileID: 759814206}
  characterExitPoint: {fileID: 684811509}
  characterOutside: {fileID: 934085767}
  door: {fileID: 1521937636}
  doorHalfWidth: 0.42
  doorOpenAngle: -90
  doorSeconds: 0.8
  doorOpenClip: {fileID: 8300000, guid: 6230b49ceb891e646a213d36dbec7b86, type: 3}
  doorCloseClip: {fileID: 8300000, guid: 449b837bfdd575143b7a5c7faa036161, type: 3}
  doorVolume: 0.55
  walkSpeed: 1.1
  lookAtCharacterOnStart: 0
  exitCue: {fileID: 0}
  exitCueVolume: 0.7
  steps:
  - note: Arrival
    waitFor: 0
    amount: 0
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Milan. I teach French to the boys, and in the evening the wind comes
          in through this window.
        voice: {fileID: 8300000, guid: 5f21bb382c647994cbc3452abc3007c3, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Carlo comes in
    waitFor: 128
    amount: 10
    objective: 
    lines: []
    action: 5
    observableIndex: 0
    fragment: 0
  - note: Carlo complains
    waitFor: 1
    amount: 0
    objective: TALK TO {character}
    lines:
    - speakerId: carlo
      pieces:
      - text: Professor! The window again. Half the trees of Milan are on my floor.
        voice: {fileID: 8300000, guid: 61ecc96662a9f9842ab9ac92f405c033, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Forgive me, Mr. Carlo. I like to feel the air from the street.
        voice: {fileID: 8300000, guid: 4e622786a1467bb43816c8d230da1748, type: 3}
        volume: 0.55
    - speakerId: carlo
      pieces:
      - text: Then you sweep it. There's the broom.
        voice: {fileID: 8300000, guid: 1b24360182635e24c97ee96bcc367fda, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Broom
    waitFor: 2
    amount: 0
    objective: PICK UP THE BROOM
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Sweep by the bed
    waitFor: 4
    amount: 120
    objective: HOLD {sweepKey} AND MOVE THE MOUSE TO SWEEP
    lines:
    - speakerId: carlo
      pieces:
      - text: And that notebook you carry everywhere. Do you ever let it go?
        voice: {fileID: 8300000, guid: 4312120670ec4fa49bb3e70277e0aaad, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Never. The broom in one hand, the notebook in the other.
        voice: {fileID: 8300000, guid: e1946deed139d3d4dace1b2bd90951ae, type: 3}
        volume: 0.55
    - speakerId: carlo
      pieces:
      - text: Show me, then. What do you write in it?
        voice: {fileID: 8300000, guid: 15977b809ee824b44bef1107148f97da, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Notebook
    waitFor: 8
    amount: 0
    objective: PRESS {diaryKey} TO OPEN THE NOTEBOOK
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Nothing yet. Words come when they please.
        voice: {fileID: 8300000, guid: 7253704ef6688964e840500b2088a18c, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 0
    fragment: 0
  - note: The chair
    waitFor: 528
    amount: 0
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: The chair... it was at the table.
        voice: {fileID: 8300000, guid: 7be9717f8e9bbd44e90985493ae54889, type: 3}
        volume: 0.55
    - speakerId: carlo
      pieces:
      - text: Of course it was. And now it's by the window. Things don't wait for
          you to look at them, Professor.
        voice: {fileID: 8300000, guid: 0dec6c887fb906b438d2395b286f4bdc, type: 3}
        volume: 0.55
    action: 2
    observableIndex: 0
    fragment: 0
  - note: The big pile
    waitFor: 160
    amount: 0
    objective: SWEEP THE BIG PILE IN THE MIDDLE OF THE ROOM
    lines:
    - speakerId: ungaretti
      pieces:
      - text: There's something underneath. Words... as if written on the floor.
        voice: {fileID: 8300000, guid: bbe82bd241126f346991d4cea3ffcc13, type: 3}
        volume: 0.55
    - speakerId: carlo
      pieces:
      - text: Words? I only see the floorboards, Professor. You look like you've
          seen a ghost.
        voice: {fileID: 8300000, guid: e5acfaa807211f4458446a179aea2ee0, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: I don't remember writing them. And yet it's my handwriting.
        voice: {fileID: 8300000, guid: 8916bfbe14b82ba41aba4d6944135282, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Transcription
    waitFor: 64
    amount: 0
    objective: KEEP YOUR EYES ON THE POEM WHILE YOU TRANSCRIBE
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Silence, Carlo leaves
    waitFor: 128
    amount: 2.5
    objective: 
    lines:
    - speakerId: carlo
      pieces:
      - text: I don't understand poetry, Professor. But that one sounded like you.
        voice: {fileID: 8300000, guid: 1138d6a4d7c1bbf47a0ca6e3341cbc05, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Thank you,Mr. Carlo. That's the finest compliment you could pay me.
        voice: {fileID: 8300000, guid: cda505235357dba43b439af99a355df1, type: 3}
        volume: 0.55
    - speakerId: carlo
      pieces:
      - text: I'll leave you to your leaves. Don't turn around too fast, or you won't
          know where you are.
        voice: {fileID: 8300000, guid: e2f1df7d0195d9c46b872178b298d635, type: 3}
        volume: 0.55
    action: 3
    observableIndex: 0
    fragment: 0
  - note: Alone
    waitFor: 128
    amount: 1.5
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: I can feel the room changing behind me. Like a page turning by itself.
        voice: {fileID: 8300000, guid: 997878120cd517b4e9230decd038554c, type: 3}
        volume: 0.55
    action: 4
    observableIndex: 0
    fragment: 0
  - note: Turn around
    waitFor: 256
    amount: 0
    objective: TURN AROUND
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  firstGustLines:
  - speakerId: carlo
    pieces:
    - text: Whatever you're looking at, keep your eyes on it. Things like that run
        as soon as you turn around.
      voice: {fileID: 8300000, guid: 02a2079e286715c48af537741da885b2, type: 3}
      volume: 0.55
  objectiveSize: 34
