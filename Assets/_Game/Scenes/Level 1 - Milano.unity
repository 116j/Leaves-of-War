--- !u!114 &348759339
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 348759334}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0337850e7688759459a31cce09b42c75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examinable
  prompt: READ
  displayName: Exercise Sheets
  caption: "My pupils' homework. They conjugate French verbs better than I can put
    my own thoughts in order.\n\n<b>Exercise 12 \u2014 Conjugate in the present tense.</b>\n<i>\xEAtre</i>:
    je suis, tu es, il est, nous sommes, vous \xEAtes, ils sont.\n<i>avoir</i>: j'ai,
    tu as, il a, nous avons, vous avez, ils ont.\n<i>partir</i>: je pars, tu pars,
    il part, nous partons, vous partez, ils partent.\n<i>tomber</i>: je tombe, tu
    tombes, il tombe, nous tombons, vous tombez, ils tombent.\n\n<b>Exercise 13 \u2014
    Translate into French.</b>\nThe leaves fall in the courtyard. \u2014 <i>Les feuilles
    tombent dans la cour.</i>\nMy brother leaves for the army. \u2014 <i>Mon fr\xE8re
    part pour l'arm\xE9e.</i>\nWe will write to him every week. \u2014 <i>Nous lui
    \xE9crirons chaque semaine.</i>\n\n<color=#8b2a1a>In red ink, in the margin:
    Good. Watch the accents. \u2014 G.U.</color>"
  model: {fileID: 348759334}
  scaleMultiplier: 1
  rotationOffset: {x: 0, y: 0, z: -180}
  voice: {fileID: 0}
  voiceVolume: 0.55
