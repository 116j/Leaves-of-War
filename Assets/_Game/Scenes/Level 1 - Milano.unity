  m_EditorClassIdentifier: Assembly-CSharp::Hortensia.Runtime.DialogueTrigger
  prompt: TALK
  startOnEnter: 0
  playOnce: 0
  lines:
  - speakerId: carlo
    pieces:
    - text: "Brumb\xE0, tel\xF2n sfar\xEC, uf\xE0!"
      voice: {fileID: 8300000, guid: 1dd1bd1bc2a97994d8afbccbe9000ac3, type: 3}
      volume: 0.733
    - text: "Tambur\xE8l dal\xF2, sgrinf\xE0 la mant\xF3la... ombr\xE8, ombr\xE8
        scrov\xE0!"
      voice: {fileID: 8300000, guid: fc79e55327acefe4ca6b8d9f28137318, type: 3}
      volume: 0.683
  - speakerId: ungaretti
    pieces:
    - text: "Sf\xF2rilo... lum\xE0rde scr\xE8nzia. G\xF2rvalo d\xF9 br\xF9nzo...
        ferl\xE0mia ond\xECre, tr\xE0sco. Vel\xECmbre sga\xF9lo, n\xEClvo."
      voice: {fileID: 8300000, guid: 133356ab8cdc3d348a7569b60920185f, type: 3}
      volume: 0.665
    - text: "P\xE8rvola... sg\xF9nzio r\xE0mbe, tirl\xECmbo dr\xE8."
      voice: {fileID: 0}
      volume: 0
  onFinished:
    m_PersistentCalls:
      m_Calls: []
