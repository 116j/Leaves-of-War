  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0337850e7688759459a31cce09b42c75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examinable
  prompt: READ
  displayName: Newspaper, 1914
  caption: "This morning's paper. All of Europe talks of nothing but war.\n\n<b>MILAN
    \u2014 EVENING EDITION \u2014 3 AUGUST 1914</b>\n\n<b>ITALY DECLARES ITS NEUTRALITY</b>\nThe
    Government announced last night that the Kingdom will take no part in the conflict
    now spreading across Europe. The Triple Alliance, the Council of Ministers declared,
    is a pact of defence, and the war Austria-Hungary has opened against Serbia is
    not a war of defence.\n\n<b>GERMANY AT WAR WITH RUSSIA AND FRANCE</b>\nTelegrams
    from Berlin confirm the general mobilisation. Trains full of soldiers leave the
    stations every hour. In Paris the crowds sing in the boulevards; in Vienna, in
    the squares.\n\n<b>IN THE CITY</b>\nLong queues outside the banks since dawn.
    The price of bread has risen by two centesimi. In the caf\xE9s of the Galleria,
    students argue until late into the night: some say Italy must stay out, others
    that she cannot stay out for long.\n\n<b>WEATHER</b>\nClear skies over Lombardy.
    Wind from the north in the evening."
  model: {fileID: 1441270181}
  scaleMultiplier: 1
  rotationOffset: {x: 0, y: 0, z: 0}
  voice: {fileID: 0}
  voiceVolume: 0.55
