--- !u!114 &1670398161
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1670398159}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b43d8063f0bd8c14195f808464096860, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AssignPoem
  _revealThreshold: 0.05
  _hideThreshold: 0.6
  _poemId: 4
  _assignedDate: "1940\u20131946"
  _assignedPoemName: Giorno per giorno
  _assignedPlace: San Paolo del Brasile
  _assignedPoemText: "\"Nessuno, mamma, ha mai sofferto tanto...\"\nE il volto gi\xE0
    scomparso\nMa gli occhi ancora vivi\nDal guanciale volgeva alla finestra,\nE
    riempivano passeri la stanza\nVerso le briciole dal babbo sparse\nPer distrarre
    il suo bimbo...\n\nOra potr\xF2 baciare solo in sogno\nLe fiduciose mani...\nE
    discorro, lavoro,\nSono appena mutato, temo, fumo...\nCome si pu\xF2 ch'io regga
    a tanta notte?...\n\nMi porteranno gli anni\nChiss\xE0 quali altri orrori,\nMa
    ti sentivo accanto,\nM'avresti consolato...\n\nMai, non saprete mai come m'illumina\nL'ombra
    che mi si pone a lato, timida,\nQuando non spero pi\xF9...\n\nIn cielo cerco
    il tuo felice volto,\nEd i miei occhi in me null'altro vedano\nQuando anch'essi
    vorr\xE0 chiudere Iddio...\nE t'amo, t'amo, ed \xE8 continuo schianto!..."
  _poemVoice: {fileID: 8300000, guid: b2fda8cb89bed324bb0da10e4b1e13ae, type: 3}
  poemInfo: {fileID: 11400000, guid: b79b9d6bac85cbf4194496d185b690f6, type: 2}
  _fragment: 0
  _fragmentCount: 1
  _fragmentText: 
  _floorColor: {r: 0.7169812, g: 0.041089572, b: 0, a: 0.85}
  _floorPadding: 0.12
  _shimmer: 1
  _fadeSeconds: 2.5
  _lettersFly: 1
  _flightSeconds: 2.4
  _flightSize: 2.6
  _spiralRadius: 0.24
  _spiralTurns: 1.5
