  _recoverCoverage: 0.7
  _gustClip: {fileID: 8300000, guid: 6cdffb7a687ce7a44b98b8a81a027979, type: 3}
  _gustClips:
  - {fileID: 8300000, guid: 6cdffb7a687ce7a44b98b8a81a027979, type: 3}
  - {fileID: 8300000, guid: 76aa4caec1ec7ed46b3f6e325795947d, type: 3}
  - {fileID: 8300000, guid: 7a5fa162d846ea041a5de316255a8b9c, type: 3}
  - {fileID: 8300000, guid: 46284661ee561b64193d6e71f7547509, type: 3}
  - {fileID: 8300000, guid: de7b4aace52594d48a2d7fdba8118e5c, type: 3}
  - {fileID: 8300000, guid: 8042d4a27d5c92f44853806827d9f0c1, type: 3}
  _gustVolume: 0.8
  _immuneToLookingAway: 0
  _lowerAfterRelease: 1
  _earlierPoems:
  - poemId: 1
    poemName: Agonia
    poemDate: 1914-1915
    poemPlace: Milano
    poemText: "Morire come le allodole assetate\nsul miraggio\nO come la quaglia\npassato
      il mare\nnei primi cespugli\nperch\xE8 di volare\nnon ha pi\xF9 voglia\nMa
      non vivere di lamento\ncome un cardellino accecato"
    poemVoice: {fileID: 8300000, guid: d0505963b9530fc408881e10bfe71d30, type: 3}
  - poemId: 2
    poemName: In memoria
    poemDate: 30 settembre 1916
    poemPlace: Locvizza
    poemText: "Si chiamava\nMoammed Sceab\nDiscendente\ndi emiri di nomadi\nsuicida\nperch\xE9
      non aveva pi\xF9\nPatria\nAm\xF2 la Francia\ne mut\xF2 nome\nFu Marcel\nma
      non era Francese\ne non sapeva pi\xF9\nvivere\nnella tenda dei suoi\ndove si
      ascolta la cantilena\ndel Corano\ngustando un caff\xE8\nE non sapeva\nsciogliere\nil
      canto\ndel suo abbandono\nL\u2019ho accompagnato\ninsieme alla padrona dell\u2019albergo\ndove
      abitavamo\na Parigi\ndal numero 5 della rue des Carmes\nappassito vicolo in
      discesa.\nRiposa\nnel camposanto d\u2019Ivry\nsobborgo che pare\nsempre\nin
      una giornata\ndi una\ndecomposta fiera\nE forse io solo\nso ancora\nche visse"
    poemVoice: {fileID: 8300000, guid: 77c9d58dd634ae54e9229db24262b160, type: 3}
  - poemId: 3
    poemName: Veglia
    poemDate: 23 dicembre 1915
    poemPlace: Cima Quattro
    poemText: "Un\u2019intera nottata\nbuttato vicino\na un compagno\nmassacrato\ncon
      la sua bocca\ndigrignata\nvolta al plenilunio\ncon la congestione\ndelle sue
      mani\npenetrata\nnel mio silenzio\nho scritto\nlettere piene d\u2019amore\n\nNon
      sono mai stato\ntanto\nattaccato alla vita"
    poemVoice: {fileID: 8300000, guid: f781ad2495c12194993bee1d1d2bf266, type: 3}
  _promptFormat: HOLD {0} TO TRANSCRIBE
  _promptSize: 30
