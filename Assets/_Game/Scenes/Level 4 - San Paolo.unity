--- !u!114 &871507839
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 871507838}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18838921448f49b4a98c9e597f9a2ccf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelFlow
  titleCard: "SAN PAOLO DEL BRASILE \u2014 1937\u20131942"
  nextScene: Level 5 - Roma
  fallbackScene: MainMenu
  character: {fileID: 1319808160}
  characterName: Rui
  lookTarget: {fileID: 0}
  entryAnchor: {fileID: 621288939}
  exitAnchor: {fileID: 1760219014}
  followerLeafFromStart: 1
  broom: {fileID: 0}
  observables:
  - {fileID: 1319808159}
  - {fileID: 643027315}
  - {fileID: 1827916623}
  - {fileID: 1641629773}
  characterExitPoint: {fileID: 1572002459}
  characterOutside: {fileID: 0}
  door: {fileID: 0}
  doorHalfWidth: 0.42
  doorOpenAngle: -90
  doorSeconds: 0.8
  doorOpenClip: {fileID: 8300000, guid: 6230b49ceb891e646a213d36dbec7b86, type: 3}
  doorCloseClip: {fileID: 8300000, guid: 449b837bfdd575143b7a5c7faa036161, type: 3}
  doorVolume: 0.55
  walkSpeed: 1.1
  lookAtCharacterOnStart: 0
  exitCue: {fileID: 0}
  exitCueVolume: 0.7
  steps:
  - note: Arrival
    waitFor: 0
    amount: 0
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Brazil. A vast nature, that keeps growing even when you aren't looking.
        voice: {fileID: 8300000, guid: 9d0cf9f8173b4ab4d99605e80c723399, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Rui
    waitFor: 4096
    amount: 0
    objective: LOOK AT RUI, BY THE GARDEN DOOR
    lines:
    - speakerId: rui
      pieces:
      - text: You're sweeping again. The students keep asking for you, Giuseppe.
        voice: {fileID: 8300000, guid: 75fbc729ad7f88a4585a64f6907f1c67, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: The leaves come in from the garden, Rui. They never stop.
        voice: {fileID: 8300000, guid: 2b2f698837aa39846908b3f782bcc5f2, type: 3}
        volume: 0.55
    - speakerId: rui
      pieces:
      - text: Neither do you.
        voice: {fileID: 8300000, guid: 0daf8e31afff1a64798c856c0581686d, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Sweep the living room
    waitFor: 4
    amount: 30
    objective: SWEEP THE LIVING ROOM
    lines:
    - speakerId: rui
      pieces:
      - text: 'Jeanne asked me to tell you: leave his corner. She doesn''t want anything
          moved.'
        voice: {fileID: 8300000, guid: 24b1b2d04f6f03e41855671999d59265, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: I won't touch a thing. I promise.
        voice: {fileID: 8300000, guid: dfb5bc0b871df5947a494e21365498d0, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 1
    fragment: 0
  - note: The drawings are gone
    waitFor: 512
    amount: 0
    objective: LOOK AWAY FROM THE CHILD'S CORNER
    lines:
    - speakerId: rui
      pieces:
      - text: His drawings... Did Jeanne take them down?
        voice: {fileID: 8300000, guid: 55965af0765c39b4391e91e4e2c6ffb3, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: No one did, Rui. Things leave on their own, when we stop looking at
          them.
        voice: {fileID: 8300000, guid: 66c6aae27f0fd7e479665cdaef54cc1a, type: 3}
        volume: 0.55
    - speakerId: rui
      pieces:
      - text: Then don't stop looking.
        voice: {fileID: 8300000, guid: a599e39468dd1b641bcb83bc439c1a14, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 1
    fragment: 0
  - note: The toy may go
    waitFor: 128
    amount: 0.1
    objective: 
    lines: []
    action: 1
    observableIndex: 2
    fragment: 0
  - note: The toy is gone
    waitFor: 512
    amount: 0
    objective: LOOK AWAY FROM THE CORNER AGAIN
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Antonietto was nine years old.
        voice: {fileID: 8300000, guid: be5b7b6a3fcf55e40bd5b1d0738a1e05, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 2
    fragment: 0
  - note: The chair may go
    waitFor: 128
    amount: 0.1
    objective: 
    lines: []
    action: 1
    observableIndex: 3
    fragment: 0
  - note: The chair is gone
    waitFor: 512
    amount: 0
    objective: LOOK AWAY FROM THE CORNER AGAIN
    lines: []
    action: 0
    observableIndex: 3
    fragment: 0
  - note: A sheet of paper
    waitFor: 32
    amount: 0
    objective: SWEEP THE LEAVES IN THE EMPTY CORNER
    lines:
    - speakerId: rui
      pieces:
      - text: 'What are you staring at, Giuseppe?

          There is nothing there.'
        voice: {fileID: 8300000, guid: aaab0b399cfe16b4eadf0563c166f344, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Not for you, Rui. For me, there's what I can't say to anyone. I wrote
          it for him.
        voice: {fileID: 8300000, guid: 28d6662c4fb32164ca1b243c94973434, type: 3}
        volume: 0.55
    - speakerId: rui
      pieces:
      - text: Read it. I'll listen.
        voice: {fileID: 8300000, guid: a5faa7abc09968e40a08ca2523a33afd, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Giorno per giorno
    waitFor: 64
    amount: 0
    objective: KEEP YOUR EYES ON THE WORDS WHILE YOU TRANSCRIBE
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Four seconds of rain
    waitFor: 128
    amount: 4
    objective: 
    lines:
    - speakerId: rui
      pieces:
      - text: It's him. You kept him.
        voice: {fileID: 8300000, guid: c7fc19ec209ad544f94695a7bccd84cd, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: It's all I know how to do. I sweep, I find, I write.
        voice: {fileID: 8300000, guid: 2422737e1dd9bc94d961d2cc2e71b37b, type: 3}
        volume: 0.55
    - speakerId: rui
      pieces:
      - text: The war is coming here too. Soon they'll send you home, to Italy.
        voice: {fileID: 8300000, guid: 640872671c87bd840a84a94cdcc2fec8, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: I'm going back. I'll take the notebook.
        voice: {fileID: 8300000, guid: c4286053d6cb10647b5129088caea593, type: 3}
        volume: 0.55
    action: 3
    observableIndex: 0
    fragment: 0
  - note: The rain stops
    waitFor: 128
    amount: 5
    objective: 
    lines: []
    action: 7
    observableIndex: 0
    fragment: 0
  - note: Only to remember
    waitFor: 128
    amount: 3
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: There's nothing left to sweep here. Only to remember.
        voice: {fileID: 8300000, guid: 43a582a313bfe404084bef5c74f0242d, type: 3}
        volume: 0.55
    action: 4
    observableIndex: 0
    fragment: 0
  - note: Turn around
    waitFor: 256
    amount: 0
    objective: TURN AWAY FROM THE FRONT DOOR
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  firstGustLines: []
  objectiveSize: 34
