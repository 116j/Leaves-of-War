--- !u!114 &1717908541
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1717908540}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18838921448f49b4a98c9e597f9a2ccf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelFlow
  titleCard: "ROMA \u2014 1943\u20131944"
  nextScene: Level 6 - Courton
  fallbackScene: MainMenu
  character: {fileID: 20055696}
  characterName: Leone
  lookTarget: {fileID: 0}
  entryAnchor: {fileID: 1671356176}
  exitAnchor: {fileID: 448091500}
  followerLeafFromStart: 1
  broom: {fileID: 0}
  observables:
  - {fileID: 20055695}
  - {fileID: 1240259855}
  characterExitPoint: {fileID: 1609492250}
  characterOutside: {fileID: 0}
  door: {fileID: 0}
  doorHalfWidth: 0.42
  doorOpenAngle: -90
  doorSeconds: 0.8
  doorOpenClip: {fileID: 8300000, guid: 6230b49ceb891e646a213d36dbec7b86, type: 3}
  doorCloseClip: {fileID: 8300000, guid: 449b837bfdd575143b7a5c7faa036161, type: 3}
  doorVolume: 0.55
  walkSpeed: 1.1
  lookAtCharacterOnStart: 0
  exitCue: {fileID: 0}
  exitCueVolume: 0.7
  forestFallSeconds: 7
  endingMusic: {fileID: 0}
  endingMusicVolume: 0.8
  steps:
  - note: Arrival
    waitFor: 0
    amount: 0
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Rome. The city is occupied. We rarely go out, we speak softly.
        voice: {fileID: 8300000, guid: d4397529c9a472947ada54badcd18f9f, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Leone
    waitFor: 4096
    amount: 0
    objective: SOMEONE IS STANDING BY THE SHUTTERS
    lines:
    - speakerId: leone
      pieces:
      - text: Professor, stay away from the window. There are soldiers at the corner
          again.
        voice: {fileID: 8300000, guid: ef13a4d2c9b3ef142a15e8b6e018e246, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: I'm not looking, Leone. I'm sweeping.
        voice: {fileID: 8300000, guid: ad4fa3cd0ab52994283412c7439922c2, type: 3}
        volume: 0.55
    - speakerId: leone
      pieces:
      - text: You sweep when you're worried. You've swept this floor three times
          since I arrived.
        voice: {fileID: 8300000, guid: 1a147b1534434ce48ac05a1872cacf36, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Sweep the study
    waitFor: 4
    amount: 25
    objective: THE STUDY IS FULL OF LEAVES
    lines: []
    action: 1
    observableIndex: 1
    fragment: 0
  - note: The voices rise
    waitFor: 512
    amount: 0
    objective: 
    lines:
    - speakerId: leone
      pieces:
      - text: Do you hear them? They're shouting again.
        voice: {fileID: 8300000, guid: e23dc10727cb7854aa66c380c5961422, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: When I look, they fall silent. When I turn away, they start again.
        voice: {fileID: 8300000, guid: 16b033b0e87bb1646922473303cf7ece, type: 3}
        volume: 0.55
    - speakerId: leone
      pieces:
      - text: Then keep looking. Someone in this house should.
        voice: {fileID: 8300000, guid: d934a7efd9cd4ad42884e3a13e720f8b, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 1
    fragment: 0
  - note: First silence
    waitFor: 4096
    amount: 0
    objective: THE VOICES COME FROM OUTSIDE
    lines:
    - speakerId: leone
      pieces:
      - text: It stopped. For now.
        voice: {fileID: 8300000, guid: 160359a6a72f4eb48979e428954ff733, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 1
    fragment: 0
  - note: They rise again
    waitFor: 512
    amount: 0
    objective: 
    lines: []
    action: 0
    observableIndex: 1
    fragment: 0
  - note: Second silence
    waitFor: 4096
    amount: 0
    objective: THE VOICES COME FROM OUTSIDE
    lines:
    - speakerId: leone
      pieces:
      - text: They're taking someone away. Don't look too long, Professor.
        voice: {fileID: 8300000, guid: 743b118151d987a46825e30f9afe4694, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 1
    fragment: 0
  - note: A third time
    waitFor: 512
    amount: 0
    objective: 
    lines: []
    action: 0
    observableIndex: 1
    fragment: 0
  - note: Third silence
    waitFor: 4096
    amount: 0
    objective: THE VOICES COME FROM OUTSIDE
    lines:
    - speakerId: leone
      pieces:
      - text: It's quiet. Too quiet. Write it down before it starts again.
        voice: {fileID: 8300000, guid: b118ac7684b77a842adc2ac41be981a0, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 1
    fragment: 0
  - note: Words on the tiles
    waitFor: 32
    amount: 0
    objective: LEAVES HAVE GATHERED BY THE DOOR
    lines:
    - speakerId: leone
      pieces:
      - text: WHAT IS IT, PROFESSOR? YOU'RE STARING AT THE FLOOR BY THE DOOR.
        voice: {fileID: 8300000, guid: ec9ef14099ed9e14aa098f53eec02a1e, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Words. Only I can see them. They're for those who can no longer speak.
        voice: {fileID: 8300000, guid: 4ee575cd1e46be24e87049ddb95de9f5, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: "Non gridate pi\xF9"
    waitFor: 64
    amount: 0
    objective: THE WORDS FADE WHEN YOU LOOK AWAY
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  - note: The other war
    waitFor: 128
    amount: 2
    objective: 
    lines:
    - speakerId: leone
      pieces:
      - text: You never talk about the other war. The first one.
        voice: {fileID: 8300000, guid: ee30868e1a729f74f90354c96bba277b, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: I think about it all the time. If I close my eyes I'm still there.
          In a wood, in France.
        voice: {fileID: 8300000, guid: ac5bce4a6cf7f9048bdc2bde1fc2a928, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Look at Leone
    waitFor: 4096
    amount: 0
    objective: LEONE IS STILL HERE
    lines:
    - speakerId: leone
      pieces:
      - text: Then close them. I'll keep watch.
        voice: {fileID: 8300000, guid: e958643a4732ddc4296a31237e06a2d7, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Close the shutters
    waitFor: 8192
    amount: 0
    objective: THE SHUTTERS ARE STILL OPEN
    lines: []
    action: 4
    observableIndex: 0
    fragment: 0
  - note: Turn away from the room
    waitFor: 256
    amount: 0
    objective: IT IS TIME TO LEAVE THE ROOM
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  firstGustLines:
  - speakerId: leone
    pieces:
    - text: Don't let them win, Professor. Finish it.
      voice: {fileID: 8300000, guid: 4971d5b28730d794ea668668e2cb62b4, type: 3}
      volume: 0.55
  objectiveSize: 34
