  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AssignPoem
  _revealThreshold: 0.05
  _hideThreshold: 0.6
  _poemId: 5
  _assignedDate: "1943\u20131944"
  _assignedPoemName: "Non gridate pi\xF9"
  _assignedPlace: Roma occupata
  _assignedPoemText: "Cessate d'uccidere i morti,\nNon gridate pi\xF9, non gridate\nSe
    li volete ancora udire,\nSe sperate di non perire.\n\nHanno l'impercettibile
    sussurro,\nNon fanno pi\xF9 rumore\nDel crescere dell'erba,\nLieta dove non passa
    l'uomo."
  _poemVoice: {fileID: 8300000, guid: 4f0e7107879aaf74fa985810673a946e, type: 3}
  poemInfo: {fileID: 11400000, guid: b79b9d6bac85cbf4194496d185b690f6, type: 2}
  _fragment: 0
