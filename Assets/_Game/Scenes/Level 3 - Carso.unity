  m_Script: {fileID: 11500000, guid: b43d8063f0bd8c14195f808464096860, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AssignPoem
  _revealThreshold: 0.05
  _hideThreshold: 0.6
  _poemId: 3
  _assignedDate: 23 dicembre 1915
  _assignedPoemName: Veglia
  _assignedPlace: Cima Quattro
  _assignedPoemText: "Un\u2019intera nottata\nbuttato vicino\na un compagno\nmassacrato\ncon
    la sua bocca\ndigrignata\nvolta al plenilunio\ncon la congestione\ndelle sue
    mani\npenetrata\nnel mio silenzio\nho scritto\nlettere piene d\u2019amore\n\nNon
    sono mai stato\ntanto\nattaccato alla vita"
  _poemVoice: {fileID: 8300000, guid: f781ad2495c12194993bee1d1d2bf266, type: 3}
  poemInfo: {fileID: 11400000, guid: b79b9d6bac85cbf4194496d185b690f6, type: 2}
  _fragment: 0
  _fragmentCount: 1
  _fragmentText: 
  _floorColor: {r: 0.12, g: 0.08, b: 0.05, a: 0.85}
  _floorPadding: 0.12
  _shimmer: 0.35
  _fadeSeconds: 2.5
