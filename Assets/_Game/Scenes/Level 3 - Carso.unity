--- !u!114 &912443456
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 912443455}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18838921448f49b4a98c9e597f9a2ccf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelFlow
  titleCard: "IL CARSO \u2014 CIMA QUATTRO \u2014 23 DICEMBRE 1915"
  nextScene: Level 4 - San Paolo
  fallbackScene: MainMenu
  character: {fileID: 998808517}
  characterName: Pietro
  lookTarget: {fileID: 0}
  entryAnchor: {fileID: 275370590}
  exitAnchor: {fileID: 2072645356}
  followerLeafFromStart: 1
  broom: {fileID: 0}
  observables:
  - {fileID: 998808516}
  - {fileID: 758197904}
  characterExitPoint: {fileID: 0}
  characterOutside: {fileID: 0}
  door: {fileID: 0}
  doorHalfWidth: 0.42
  doorOpenAngle: -90
  doorSeconds: 0.8
  doorOpenClip: {fileID: 8300000, guid: 6230b49ceb891e646a213d36dbec7b86, type: 3}
  doorCloseClip: {fileID: 8300000, guid: 449b837bfdd575143b7a5c7faa036161, type: 3}
  doorVolume: 0.55
  walkSpeed: 1.1
  lookAtCharacterOnStart: 0
  exitCue: {fileID: 0}
  exitCueVolume: 0.7
  steps:
  - note: Arrival
    waitFor: 0
    amount: 0
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Cima Quattro. The night before Christmas.
        voice: {fileID: 8300000, guid: 3e68e485960f20a43833c60a999c6029, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: This is home now. Stones, sandbags, a blanket.
        voice: {fileID: 8300000, guid: a89c045a948139e4081c810afacf2a01, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Pietro's lantern
    waitFor: 4096
    amount: 0
    objective: LOOK AT THE LANTERN AT THE END OF THE TRENCH
    lines:
    - speakerId: pietro
      pieces:
      - text: Who's there? Are you hurt?
        voice: {fileID: 8300000, guid: 00b1b78d561940f4f8b131892761680d, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: No, friend. I'm just awake.
        voice: {fileID: 8300000, guid: 35735ab5830e0fc4ab6e9958901b35c1, type: 3}
        volume: 0.55
    - speakerId: pietro
      pieces:
      - text: Everyone is awake tonight. Nobody can sleep with the guns like this.
        voice: {fileID: 8300000, guid: 9bf08f8cd05d5a04d8fb0a73898fd73a, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Sweep in the dark
    waitFor: 4
    amount: 30
    objective: SWEEP THE TRENCH FLOOR
    lines:
    - speakerId: pietro
      pieces:
      - text: What are you looking for down there?
        voice: {fileID: 8300000, guid: a3af7e498eec18c4ca105eb2977357aa, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Words. Sometimes I see them among the stones, before I've even written
          them.
        voice: {fileID: 8300000, guid: c5d94509f2f563e4a921ae0df7838f94, type: 3}
        volume: 0.55
    - speakerId: pietro
      pieces:
      - text: Then you need light. Stay close, I'll come back this way.
        voice: {fileID: 8300000, guid: 3989654287dc11041b859d3208e42aa1, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 0
    fragment: 0
  - note: Follow the lantern
    waitFor: 512
    amount: 0
    objective: 'FOLLOW THE LANTERN: EACH TIME YOU LOOK AWAY, PIETRO MOVES ON'
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  - note: The companion
    waitFor: 4096
    amount: 0
    objective: LOOK AT THE PLACE BESIDE YOU, UNDER THE BLANKET
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Beside me there's a comrade who no longer moves.
        voice: {fileID: 8300000, guid: 01de8288c35b29749a5a82118e48b39f, type: 3}
        volume: 0.55
      - text: I've felt him there all night, even without looking.
        voice: {fileID: 8300000, guid: 08cdee2f700a885419ba7bc7f884f0fc, type: 3}
        volume: 0.55
    - speakerId: pietro
      pieces:
      - text: I'm sorry. I can't do anything for him now. We'll take him down at
          first light.
        voice: {fileID: 8300000, guid: 46988b3b14efe3f49bca886cb91e63a1, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: I know. I'll stay with him until morning.
        voice: {fileID: 8300000, guid: 52b4baec12051ad48b94aef59dd6fcdd, type: 3}
        volume: 0.55
    - speakerId: pietro
      pieces:
      - text: Then I'll leave you the light for a while.
        voice: {fileID: 8300000, guid: 72c283ce4c9072247b9fcffd2c265670, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 1
    fragment: 0
  - note: Pietro leaves the light
    waitFor: 128
    amount: 0.1
    objective: 
    lines: []
    action: 1
    observableIndex: 0
    fragment: 0
  - note: The postcard
    waitFor: 32
    amount: 0
    objective: SWEEP BESIDE YOUR COMPANION, IN THE LANTERN LIGHT
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Veglia
    waitFor: 64
    amount: 0
    objective: KEEP YOUR EYES ON THE WORDS WHILE YOU TRANSCRIBE
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  - note: Silence
    waitFor: 128
    amount: 3
    objective: 
    lines: []
    action: 1
    observableIndex: 0
    fragment: 0
  - note: Pietro comes back
    waitFor: 512
    amount: 0
    objective: 'LOOK AWAY: PIETRO IS COMING BACK FOR THE LANTERN'
    lines:
    - speakerId: pietro
      pieces:
      - text: You wrote all night.
        voice: {fileID: 8300000, guid: 47ae480dda7f1cf428ec40f1ba2494e7, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: To stay awake. To stay alive.
        voice: {fileID: 8300000, guid: 7ed292de46c368e4183eb895471d470c, type: 3}
        volume: 0.55
    - speakerId: pietro
      pieces:
      - text: Keep writing, then. Some of us need to know someone is.
        voice: {fileID: 8300000, guid: 41d86a3968a9dec4e90b50bac575bc88, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 0
    fragment: 0
  - note: Pietro is gone
    waitFor: 512
    amount: 0
    objective: LOOK AWAY FROM PIETRO
    lines: []
    action: 1
    observableIndex: 1
    fragment: 0
  - note: The place is empty
    waitFor: 512
    amount: 0
    objective: LOOK AT YOUR COMPANION, THEN LOOK AWAY
    lines:
    - speakerId: ungaretti
      pieces:
      - text: One day, the war ended. The leaves kept falling. And I crossed the
          sea.
        voice: {fileID: 8300000, guid: 17923d56a25496e4cb5061da9fe4586d, type: 3}
        volume: 0.55
    action: 4
    observableIndex: 1
    fragment: 0
  - note: Turn around
    waitFor: 256
    amount: 0
    objective: TURN AWAY FROM THE END OF THE TRENCH
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
  firstGustLines:
  - speakerId: pietro
    pieces:
    - text: Don't lose it. Whatever you're writing, it matters tonight.
      voice: {fileID: 8300000, guid: a0edc391440e17b4bbb5978cbd0b68fe, type: 3}
      volume: 0.55
  objectiveSize: 34
