  _recoverCoverage: 0.7
  _gustClip: {fileID: 8300000, guid: 301b8dcfe0d163e4fa64c3a24e8ec4e2, type: 3}
  _gustClips:
  - {fileID: 8300000, guid: 301b8dcfe0d163e4fa64c3a24e8ec4e2, type: 3}
  - {fileID: 8300000, guid: 5710ed42c2b1d274c93ab0178277bcdf, type: 3}
  - {fileID: 8300000, guid: e81b6cd175194084db90e3642b671e5d, type: 3}
  - {fileID: 8300000, guid: ddd0cf49f825f5b41a3daec70803ffd1, type: 3}
  - {fileID: 8300000, guid: b9fe579a39c1c1b4fab87fee88db8522, type: 3}
  _gustVolume: 0.8
  _immuneToLookingAway: 0
  _lowerAfterRelease: 1
  _earlierPoems:
  - poemId: 1
    poemName: Agonia
    poemDate: 1914-1915
    poemPlace: Milano
    poemText: "Morire come le allodole assetate\nsul miraggio\nO come la quaglia\npassato
      il mare\nnei primi cespugli\nperch\xE8 di volare\nnon ha pi\xF9 voglia\nMa
      non vivere di lamento\ncome un cardellino accecato"
    poemVoice: {fileID: 8300000, guid: d0505963b9530fc408881e10bfe71d30, type: 3}
  - poemId: 2
    poemName: In memoria
    poemDate: 30 settembre 1916
    poemPlace: Locvizza
    poemText: "Si chiamava\nMoammed Sceab\nDiscendente\ndi emiri di nomadi\nsuicida\nperch\xE9
      non aveva pi\xF9\nPatria\nAm\xF2 la Francia\ne mut\xF2 nome\nFu Marcel\nma
      non era Francese\ne non sapeva pi\xF9\nvivere\nnella tenda dei suoi\ndove si
      ascolta la cantilena\ndel Corano\ngustando un caff\xE8\nE non sapeva\nsciogliere\nil
      canto\ndel suo abbandono\nL\u2019ho accompagnato\ninsieme alla padrona dell\u2019albergo\ndove
      abitavamo\na Parigi\ndal numero 5 della rue des Carmes\nappassito vicolo in
      discesa.\nRiposa\nnel camposanto d\u2019Ivry\nsobborgo che pare\nsempre\nin
      una giornata\ndi una\ndecomposta fiera\nE forse io solo\nso ancora\nche visse"
    poemVoice: {fileID: 8300000, guid: 77c9d58dd634ae54e9229db24262b160, type: 3}
  - poemId: 3
    poemName: Veglia
    poemDate: 23 dicembre 1915
    poemPlace: Cima Quattro
    poemText: "Un\u2019intera nottata\nbuttato vicino\na un compagno\nmassacrato\ncon
      la sua bocca\ndigrignata\nvolta al plenilunio\ncon la congestione\ndelle sue
      mani\npenetrata\nnel mio silenzio\nho scritto\nlettere piene d\u2019amore"
    poemVoice: {fileID: 8300000, guid: f781ad2495c12194993bee1d1d2bf266, type: 3}
  - poemId: 4
    poemName: Giorno per giorno
    poemDate: "1940\u20131946"
    poemPlace: San Paolo del Brasile
    poemText: "\"Nessuno, mamma, ha mai sofferto tanto...\"\nE il volto gi\xE0 scomparso\nMa
      gli occhi ancora vivi\nDal guanciale volgeva alla finestra,\nE riempivano passeri
      la stanza\nVerso le briciole dal babbo sparse\nPer distrarre il suo bimbo...\n\nOra
      potr\xF2 baciare solo in sogno\nLe fiduciose mani...\nE discorro, lavoro,\nSono
      appena mutato, temo, fumo...\nCome si pu\xF2 ch'io regga a tanta notte?...\n\nMi
      porteranno gli anni\nChiss\xE0 quali altri orrori,\nMa ti sentivo accanto,\nM'avresti
      consolato...\n\nMai, non saprete mai come m'illumina\nL'ombra che mi si pone
      a lato, timida,\nQuando non spero pi\xF9...\n\nIn cielo cerco il tuo felice
      volto,\nEd i miei occhi in me null'altro vedano\nQuando anch'essi vorr\xE0
      chiudere Iddio...\nE t'amo, t'amo, ed \xE8 continuo schianto!..."
    poemVoice: {fileID: 8300000, guid: b2fda8cb89bed324bb0da10e4b1e13ae, type: 3}
  - poemId: 5
    poemName: "Non gridate pi\xF9"
    poemDate: "1943\u20131944"
    poemPlace: Roma occupata
    poemText: "Cessate d'uccidere i morti,\nNon gridate pi\xF9, non gridate\nSe li
      volete ancora udire,\nSe sperate di non perire.\n\nHanno l'impercettibile sussurro,\nNon
      fanno pi\xF9 rumore\nDel crescere dell'erba,\nLieta dove non passa l'uomo."
    poemVoice: {fileID: 8300000, guid: 4f0e7107879aaf74fa985810673a946e, type: 3}
  _promptFormat: PRESS {0} TO TRANSCRIBE
  _promptSize: 30
