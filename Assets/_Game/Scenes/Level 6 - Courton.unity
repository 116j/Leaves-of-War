MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1290292019}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18838921448f49b4a98c9e597f9a2ccf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelFlow
  titleCard: "BOSCO DI COURTON \u2014 LUGLIO 1918"
  nextScene: MainMenu
  fallbackScene: MainMenu
  character: {fileID: 1098616125}
  characterName: Lucien
  lookTarget: {fileID: 0}
  entryAnchor: {fileID: 2078198637}
  exitAnchor: {fileID: 458618315}
  followerLeafFromStart: 1
  broom: {fileID: 0}
  observables:
  - {fileID: 1098616124}
  - {fileID: 727439394}
  - {fileID: 952378408}
  - {fileID: 1403366034}
  - {fileID: 181608985}
  characterExitPoint: {fileID: 1378600084}
  characterOutside: {fileID: 1378600084}
  door: {fileID: 0}
  doorHalfWidth: 0.42
  doorOpenAngle: -90
  doorSeconds: 0.8
  doorOpenClip: {fileID: 8300000, guid: 6230b49ceb891e646a213d36dbec7b86, type: 3}
  doorCloseClip: {fileID: 8300000, guid: 449b837bfdd575143b7a5c7faa036161, type: 3}
  doorVolume: 0.55
  walkSpeed: 1.1
  lookAtCharacterOnStart: 0
  exitCue: {fileID: 0}
  exitCueVolume: 0.7
  forestFallSeconds: 7
  endingMusic: {fileID: 8300000, guid: 2db9608690b37794799bad40a0752eca, type: 3}
  endingMusicVolume: 0.8
  steps:
  - note: Arrival
    waitFor: 0
    amount: 0
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: Courton. France. The last summer of the war.
        voice: {fileID: 8300000, guid: 1b81dbe42e42fc64e8fbfcc4049b2107, type: 3}
        volume: 0.55
    action: 5
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  - note: Lucien
    waitFor: 4096
    amount: 0
    objective: SOMEONE IS WAITING IN THE CLEARING
    lines:
    - speakerId: lucien
      pieces:
      - text: Water, soldier? It's a warm night.
        voice: {fileID: 8300000, guid: 7fe50fccd1a0d8148a94fbd3ae9d73c2, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Thank you. You shouldn't be out here at night.
        voice: {fileID: 8300000, guid: 72df4b9b97062c9408136a491e43e988, type: 3}
        volume: 0.55
    - speakerId: lucien
      pieces:
      - text: Nobody should be here. But here we all are.
        voice: {fileID: 8300000, guid: c1c52cd9db28a564f961f24a1115397e, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  - note: The trees may turn
    waitFor: 128
    amount: 0.1
    objective: 
    lines: []
    action: 1
    observableIndex: 2
    fragment: 0
    changeOnTouch: 0
  - note: The trees may turn
    waitFor: 128
    amount: 0.1
    objective: 
    lines: []
    action: 1
    observableIndex: 3
    fragment: 0
    changeOnTouch: 0
  - note: Sweep the clearing
    waitFor: 4
    amount: 20
    objective: THE CLEARING IS BURIED IN LEAVES
    lines: []
    action: 1
    observableIndex: 1
    fragment: 0
    changeOnTouch: 0
  - note: Green a moment ago
    waitFor: 512
    amount: 0
    objective: THERE ARE STILL LEAVES IN THE CLEARING
    lines:
    - speakerId: lucien
      pieces:
      - text: Strange. They were green a moment ago.
        voice: {fileID: 8300000, guid: cd677ae2fbd6b0642a04fb2b6f02a935, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: They fall when I'm not looking. Like us.
        voice: {fileID: 8300000, guid: 3d3fdc552c8a4c04298b68ac413e62a2, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 4
    fragment: 0
    changeOnTouch: 0
  - note: Men you can't see
    waitFor: 128
    amount: 6
    objective: 
    lines:
    - speakerId: lucien
      pieces:
      - text: My son wrote that the wood is full of men you can't see.
        voice: {fileID: 8300000, guid: 3e99f2303dedad04bb2aa16e666cb1e3, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: He's right. We're all here. You only have to turn around.
        voice: {fileID: 8300000, guid: c02ac4fd23f881347be207ed6e05d94b, type: 3}
        volume: 0.55
    - speakerId: lucien
      pieces:
      - text: Then don't turn around. Look at what you're writing.
        voice: {fileID: 8300000, guid: de19186a86c97f440b6a2fb6842be732, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  - note: The paper
    waitFor: 32
    amount: 0
    objective: SOMETHING LIES IN THE MIDDLE OF THE CLEARING
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  - note: Soldati
    waitFor: 64
    amount: 0
    objective: 
    lines: []
    action: 0
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  - note: Silence
    waitFor: 128
    amount: 4
    objective: 
    lines:
    - speakerId: lucien
      pieces:
      - text: Is it finished?
        voice: {fileID: 8300000, guid: e85f4ab69ac64bb489245ab53f5dcec6, type: 3}
        volume: 0.55
    - speakerId: ungaretti
      pieces:
      - text: Yes. It was already here. I only found it, under the leaves.
        voice: {fileID: 8300000, guid: f0625f6eb224bf04096da8f7b1a0cb7d, type: 3}
        volume: 0.55
    action: 0
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  - note: Look at Lucien
    waitFor: 4096
    amount: 0
    objective: LUCIEN IS STILL HERE
    lines:
    - speakerId: lucien
      pieces:
      - text: Then keep it safe. Some of these leaves won't see the autumn.
        voice: {fileID: 8300000, guid: 0511c8172ff529541873157d3fec0de0, type: 3}
        volume: 0.55
    action: 1
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  - note: Lucien is gone
    waitFor: 512
    amount: 0
    objective: SOME GOODBYES ONLY HAPPEN WHEN YOU ARE NOT LOOKING
    lines: []
    action: 9
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  - note: Every leaf falls
    waitFor: 128
    amount: 7
    objective: 
    lines:
    - speakerId: ungaretti
      pieces:
      - text: The poems were already here. You only had to look at them. Without
          turning away.
        voice: {fileID: 8300000, guid: 04403293bb6aef14981fe040831fff6a, type: 3}
        volume: 0.55
    action: 8
    observableIndex: 0
    fragment: 0
    changeOnTouch: 0
  firstGustLines: []
  objectiveSize: 34
  hintDelay: 35
  breathingTime: 6
  minimumGap: 2.5
